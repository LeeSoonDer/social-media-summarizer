{
  "manifest_version": 3,
  "name": "Social Extractor",
  "description": "右侧工作台：采下当前页的正文、图上的字，复制给任意网页 AI",
  "version": "0.8.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开 Social Extractor 工作台",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://www.instagram.com/*",
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.linkedin.com/*",
        "https://www.facebook.com/*",
        "https://www.tiktok.com/*",
        "https://www.threads.net/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "打开 Social Extractor 工作台"
    },
    "scan-screen": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "扫当前这一屏的画面文字"
    },
    "quick-note": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "跳到笔记输入框记一句"
    }
  }
}
